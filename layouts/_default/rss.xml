{{- $key := "main" -}}
{{- if and .Section (ne .Section "archives") }}{{ $key = .Section }}{{ end -}}
{{- $sec := index hugo.Data.sections $key -}}
{{- $section := "archives" -}}
{{- if ne $key "main" }}{{ $section = $key }}{{ end -}}
{{- $pages := where site.RegularPages "Section" $section -}}
{{- $pages = where $pages "Type" "not in" (slice "termpage" "listpage") -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ $sec.name | html }}</title>
		<link>{{ absURL (strings.TrimPrefix "/" $sec.home) }}</link>
		<description>{{ $sec.subtitle | html }}</description>
		<language>zh-CN</language>
		<lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
		{{- with .OutputFormats.Get "RSS" }}
		<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>
		{{- end }}
		{{- range first 20 $pages }}
		<item>
			<title>{{ .Title | html }}</title>
			<link>{{ .Permalink }}</link>
			<pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
			<guid isPermaLink="true">{{ .Permalink }}</guid>
			<description>{{ .Summary | plainify | html }}</description>
		</item>
		{{- end }}
	</channel>
</rss>
